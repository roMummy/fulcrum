.venv/
.venv311/
__pycache__/
*.pyc
.env
# Docker 部署配置包含数据库和认证凭证，只能保留在部署主机，禁止进入版本库。
.env.docker
data/*.db
data/*.bak
.pytest_cache/
logs/
# 本地启动服务生成的运行日志不进入版本库。
*.log
memory/
.run/
tmp/
.idea
data/temp/
# 开放接口发文件会生成本地出站文件缓存，属于运行时数据，不进入版本库。
data/outbound_files/
# 入站文件缓存包含供应商回传附件和本地调试文件，不进入版本库。
data/inbound_files/
# brainstorming 可视化预览只用于本地讨论，不进入版本库。
.superpowers/

*.exe

# 本机部署凭据（201 服务器与 Git 账号），禁止进入版本库。
.env.deploy
